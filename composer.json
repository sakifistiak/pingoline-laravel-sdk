{
    "name": "pingoline/laravel-sdk",
    "description": "Official PingoLine SDK for Laravel - Automated Order Confirmation Calls, SMS Gateway, IVR & Telephony in Bangladesh.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pingoline",
        "laravel",
        "order-confirmation",
        "bangladesh",
        "ivr",
        "telephony",
        "sms",
        "telecom",
        "ecommerce",
        "call-center"
    ],
    "homepage": "https://pingoline.com",
    "support": {
        "email": "hello@pingoline.com",
        "issues": "https://github.com/sakifistiak/pingoline-laravel-sdk/issues",
        "source": "https://github.com/sakifistiak/pingoline-laravel-sdk"
    },
    "authors": [
        {
            "name": "PingoLine",
            "email": "hello@pingoline.com",
            "homepage": "https://pingoline.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "PingoLine\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PingoLine\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PingoLine\\Laravel\\PingoLineServiceProvider"
            ],
            "aliases": {
                "PingoLine": "PingoLine\\Laravel\\Facades\\PingoLine"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
